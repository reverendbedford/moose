[Tests]
  design = 'SphereContactor.md RigidBodyNodalNCPKernel.md RigidBodyNormalMechanicalContact.md'
  issues = '#0000'
  [hertz_elastic]
    type = 'CSVDiff'
    input = 'hertz_elastic.i'
    csvdiff = 'hertz_elastic_csv.csv hertz_elastic_csv_contact_lm_0010.csv'
    rel_err = 1e-4
    max_parallel = 1
    requirement = 'The system shall drive a rigid sphere into an elastic half-space (2D '
                  'axisymmetric) using a nodewise semismooth-Newton NCP against an analytic '
                  'level-set contactor, without mortar-segment integration and without AD.'
  []
  [hertz_elastic-jac]
    type = 'PetscJacobianTester'
    input = 'hertz_elastic.i'
    prereq = 'hertz_elastic'
    ratio_tol = 1e-1     # min-NCP kink at initial state widens the FD-vs-hand-coded gap
    difference_tol = 2.0
    cli_args = 'Executioner/num_steps=1 -snes_test_err 1e-8'
    max_parallel = 1
    requirement = 'The system shall assemble a hand-coded Jacobian for the analytic-level-set '
                  'rigid-elastic Hertz setup within a semismooth-Newton-consistent tolerance.'
  []
[]
