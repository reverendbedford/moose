[Tests]
  design = 'ComputeMultipleInelasticStress.md ComputeLagrangianWrappedStress.md'
  issues = '#0000'
  [hertz_inelastic]
    type = 'CSVDiff'
    input = 'hertz_inelastic.i'
    csvdiff = 'hertz_inelastic_csv.csv hertz_inelastic_csv_contact_lm_0010.csv'
    rel_err = 1e-4
    max_parallel = 1
    requirement = 'The system shall drive a rigid sphere into a J2-plasticity half-space (2D '
                  'axisymmetric, small strain, radial-return) using dual-basis '
                  'Lagrange-multiplier mortar contact with the new-Lagrangian kernel pipeline, '
                  'reach a nonzero plastic zone, and converge each load step in a small number '
                  'of semismooth-Newton iterations.'
  []
  [hertz_inelastic-jac]
    type = 'PetscJacobianTester'
    input = 'hertz_inelastic.i'
    prereq = 'hertz_inelastic'
    # Initial state is elastic (no plastic strain yet), so the plastic-tangent gap in
    # IsotropicPlasticityStressUpdate (elastic-only tangent) does not enter this initial J
    # comparison. Ratio is dominated by the FB / semismooth-Newton kink.
    ratio_tol = 5e-2
    difference_tol = 1.0
    cli_args = 'Executioner/num_steps=1 -snes_test_err 1e-8'
    max_parallel = 1
    requirement = 'The system shall assemble a hand-coded Jacobian for the rigid-inelastic Hertz '
                  'setup whose Frobenius norm agrees with the finite-difference Jacobian at the '
                  'initial state within a semismooth-Newton-consistent tolerance.'
  []
[]
